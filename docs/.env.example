# Used to fetch docs content
NUXT_GITHUB_TOKEN=
# Enables AI Chat; works with AI Gateway or any OpenAI-compatible provider
AI_API_KEY=
# Optional: OpenAI-compatible endpoint. Leave empty to route through AI Gateway.
# e.g. https://api.deepseek.com/v1
AI_BASE_URL=

# Optional: Set the default model and the model list for the docs site.
# NUXT_PUBLIC_AI_CHAT_MODEL=cloudflare/@cf/qwen/qwen3.8-27b

# D1 database UUID for Cloudflare builds. Leave empty for local Wrangler preview.
CLOUDFLARE_D1_DATABASE_ID=
