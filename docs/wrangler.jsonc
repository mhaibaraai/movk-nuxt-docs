{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "movk-nuxt-docs",
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true,
      "head_sampling_rate": 0.1
    },
    "traces": {
      "enabled": false
    },
    "issues": {
      "enabled": true
    }
  }
}
