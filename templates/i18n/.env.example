# Used to fetch docs content
NUXT_GITHUB_TOKEN=
# Enables AI Chat; works with AI Gateway or any OpenAI-compatible provider.
# AI dependencies are not installed by default, add them first:
# pnpm add ai @ai-sdk/openai @ai-sdk/vue @comark/vue @shikijs/engine-javascript @shikijs/langs @shikijs/themes
# See https://docs.mhaibaraai.cn/docs/ai/ai-chat
AI_API_KEY=
# Optional: OpenAI-compatible endpoint. Leave empty to route through AI Gateway.
# e.g. https://api.deepseek.com/v1
AI_BASE_URL=
